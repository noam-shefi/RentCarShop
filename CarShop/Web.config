<?xml version="1.0"?>
<configuration>
  <!-- הוספת תצורת Serialization למניעת שגיאות אורך ב-WebMethod עם נתוני שמע ארוכים -->
  <system.web.extensions>
    <scripting>
      <webServices>
        <jsonSerialization maxJsonLength="2147483647"/>
      </webServices>
    </scripting>
  </system.web.extensions>
  <appSettings>
    <!-- NOTE: Credentials should be stored in Azure Key Vault or environment variables -->
    <!-- SmtpFromEmail, SmtpAppPassword, SmtpHost, SmtpPort should be configured in production -->
    <!-- ApiKey should be configured in production -->
  </appSettings>
  <system.web>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Net.Http, Version=4.2.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
      </assemblies>
    </compilation>
    <!-- הגדלת נפח הבקשה המותר ל-20MB והארכת זמן ה-Timeout ל-5 דקות -->
    <httpRuntime targetFramework="4.8" maxRequestLength="20480" executionTimeout="300"/>
    <sessionState mode="InProc" timeout="60"/>
    <pages controlRenderingCompatibilityVersion="4.0"/>
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear/>
        <add value="Default.aspx"/>
      </files>
    </defaultDocument>
    <!-- התאמת מגבלת הרוחב ברמת IIS למניעת חסימת נתוני השמע -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520"/>
      </requestFiltering>
    </security>
  </system.webServer>
  <connectionStrings>
    <add name="CarShopDB" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=CarShopDB;Integrated Security=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
</configuration>